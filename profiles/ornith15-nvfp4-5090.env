# Ornith-1.5-9B, NVFP4 W4A4 with MTP head (community build by protoLabsAI; upstream ships no NVFP4). RTX 5090.
MODEL_NAME=ornith-1.5-9b-nvfp4
MODEL_REPO=protoLabsAI/Ornith-1.5-9B-NVFP4
SERVED_MODEL_NAME=protoLabsAI/Ornith-1.5-9B-NVFP4
MAX_SEQS=8
GPU_UTIL=0.90
MAX_LEN=32768
KV_CACHE_DTYPE=auto
ENFORCE_EAGER=0
TRUST_REMOTE_CODE=1
EXTRA_ARGS="--enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3"
VLLM_USE_TRITON_FP8_GEMM=1  # sm120 note from the model card
