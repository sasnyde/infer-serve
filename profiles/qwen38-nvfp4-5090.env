# Qwen3.8-27B, NVFP4, single RTX 5090. The vLLM recipe requires --enforce-eager on one 5090 (slower decode).
MODEL_NAME=qwen3.8-27b-nvfp4
MODEL_REPO=Inferact/Qwen3.8-27B-NVFP4
SERVED_MODEL_NAME=Inferact/Qwen3.8-27B-NVFP4
MAX_SEQS=4
GPU_UTIL=0.90
MAX_LEN=32768
KV_CACHE_DTYPE=fp8
ENFORCE_EAGER=1
TRUST_REMOTE_CODE=1
EXTRA_ARGS="--enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3"
