# Qwen3.8-27B, official FP8, RTX PRO 6000. Hybrid linear attention + vision tower; 262K native context.
MODEL_NAME=qwen3.8-27b-fp8
MODEL_REPO=Qwen/Qwen3.8-27B-FP8
SERVED_MODEL_NAME=Qwen/Qwen3.8-27B-FP8
MAX_SEQS=10
GPU_UTIL=0.63
MAX_LEN=32768
KV_CACHE_DTYPE=fp8          # recipe default for this model; set auto to compare
ENFORCE_EAGER=0
TRUST_REMOTE_CODE=0
EXTRA_ARGS="--enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3"
