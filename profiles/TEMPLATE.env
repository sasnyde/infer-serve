# Copy to <name>.env on the volume and edit. Every variable and what it does:
MODEL_NAME=                 # directory name under /workspace/muse/models and /tmp/models
MODEL_REPO=                 # Hugging Face repo to download when no mirror exists
SERVED_MODEL_NAME=          # model id your app sends; defaults to MODEL_REPO
MAX_SEQS=10                 # --max-num-seqs: active sequences (not HTTP connections)
GPU_UTIL=0.63               # --gpu-memory-utilization: VRAM fraction for weights + runtime + KV
MAX_LEN=32768               # --max-model-len: prompt + output tokens accepted per request
KV_CACHE_DTYPE=auto         # auto | fp8
ENFORCE_EAGER=0             # 1 disables CUDA graphs (needed for Qwen3.8 NVFP4 on one 5090)
TRUST_REMOTE_CODE=0         # 1 passes --trust-remote-code
TP=1                        # --tensor-parallel-size; 2 for a 2x GPU Pod
EXTRA_ARGS=""               # any other vllm serve flags, e.g. parsers or --speculative-config
# Optional vLLM environment overrides (image defaults: DEEP_GEMM off, FLASHINFER_SAMPLER off):
# VLLM_USE_DEEP_GEMM=0
# VLLM_MOE_USE_DEEP_GEMM=0
# VLLM_USE_FLASHINFER_SAMPLER=0
# VLLM_USE_TRITON_FP8_GEMM=1
