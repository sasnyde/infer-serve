#!/usr/bin/env bash
# Create the volume layout and copy the shipped profiles (never overwrites an existing profile).
set -Eeuo pipefail
# shellcheck disable=SC1091
. /usr/local/lib/infer/infer-lib.sh
mkdir -p "$INFER_DIR/profiles" "$INFER_DIR/models" "$INFER_DIR/bench"
for f in /opt/infer/profiles/*.env; do
  name="$(basename "$f")"
  if [ -e "$INFER_DIR/profiles/$name" ]; then
    log "keep existing profile $name"
  else
    cp "$f" "$INFER_DIR/profiles/$name"
    log "installed profile $name"
  fi
done
[ -e "$INFER_DIR/local.env" ] || printf '# Overrides applied after the profile. Example:\n# MAX_SEQS=8\n' > "$INFER_DIR/local.env"
[ -s "$INFER_DIR/active-profile" ] || printf 'muse-fp8-6000\n' > "$INFER_DIR/active-profile"
log "layout ready under $INFER_DIR"
ls -la "$INFER_DIR" "$INFER_DIR/profiles"
