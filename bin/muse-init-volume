#!/usr/bin/env bash
# Create the volume layout and copy the shipped profiles (never overwrites an existing profile).
set -Eeuo pipefail
# shellcheck disable=SC1091
. /usr/local/lib/muse/muse-lib.sh
mkdir -p "$MUSE_DIR/profiles" "$MUSE_DIR/models" "$MUSE_DIR/bench"
for f in /opt/muse/profiles/*.env; do
  name="$(basename "$f")"
  if [ -e "$MUSE_DIR/profiles/$name" ]; then
    log "keep existing profile $name"
  else
    cp "$f" "$MUSE_DIR/profiles/$name"
    log "installed profile $name"
  fi
done
[ -e "$MUSE_DIR/local.env" ] || printf '# Overrides applied after the profile. Example:\n# MAX_SEQS=8\n' > "$MUSE_DIR/local.env"
[ -s "$MUSE_DIR/active-profile" ] || printf 'muse-fp8-6000\n' > "$MUSE_DIR/active-profile"
log "layout ready under $MUSE_DIR"
ls -la "$MUSE_DIR" "$MUSE_DIR/profiles"
